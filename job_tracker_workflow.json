{
  "name": "Job Tracker & CV Matching Workflow",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 8 * * 1-5"
            }
          ]
        }
      },
      "id": "schedule-trigger",
      "name": "Daily Trigger (Mon-Fri 8AM)",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        240,
        300
      ]
    },
    {
      "parameters": {},
      "id": "manual-trigger",
      "name": "Manual Trigger",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [
        240,
        460
      ]
    },
    {
      "parameters": {
        "url": "https://remoteok.com/api",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "User-Agent",
              "value": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36"
            }
          ]
        }
      },
      "id": "fetch-jobs",
      "name": "Fetch Remote Jobs",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        500,
        380
      ]
    },
    {
      "parameters": {
        "jsCode": "// Define candidate target profile\nconst targetSkills = ['react', 'node', 'javascript', 'typescript', 'python', 'sql', 'docker', 'api'];\nconst minScore = 50;\n\nconst items = $input.all();\nconst jobs = Array.isArray(items[0]?.json) ? items[0].json : items.map(i => i.json);\nconst results = [];\n\nfor (const job of jobs) {\n  if (!job.position || !job.url || job.legal) continue;\n\n  const role = job.position || 'Developer';\n  const company = job.company || 'Tech Company';\n  const location = job.location || 'Remote';\n  const tags = Array.isArray(job.tags) ? job.tags : [];\n  const applyUrl = job.url.startsWith('http') ? job.url : `https://remoteok.com${job.url}`;\n  \n  const textToScan = `${role} ${tags.join(' ')} ${job.description || ''}`.toLowerCase();\n  const matched = targetSkills.filter(skill => textToScan.includes(skill));\n  \n  // Calculate match score (0 - 100%)\n  const matchScore = Math.min(100, Math.round((matched.length / 4) * 100));\n  \n  if (matchScore >= minScore) {\n    results.push({\n      date: new Date().toISOString().split('T')[0],\n      company: company,\n      role: role,\n      score: `${matchScore}%`,\n      location: location,\n      techStack: tags.slice(0, 5).join(', '),\n      applyUrl: applyUrl,\n      status: 'To Apply'\n    });\n  }\n}\n\n// Return top 10 best matches\nreturn results.slice(0, 10).map(j => ({ json: j }));"
      },
      "id": "match-cv",
      "name": "Parse & Match CV",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        740,
        380
      ]
    },
    {
      "parameters": {
        "operation": "append",
        "sheetName": "Job Applications",
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "Date Found": "={{ $json.date }}",
            "Company": "={{ $json.company }}",
            "Role": "={{ $json.role }}",
            "Match Score %": "={{ $json.score }}",
            "Tech Stack": "={{ $json.techStack }}",
            "Location": "={{ $json.location }}",
            "Apply URL": "={{ $json.applyUrl }}",
            "Application Status": "={{ $json.status }}"
          }
        },
        "options": {}
      },
      "id": "google-sheets",
      "name": "Save to Google Sheets",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [
        980,
        380
      ]
    },
    {
      "parameters": {
        "fromEmail": "notifications@jobtracker.ai",
        "toEmail": "your.email@example.com",
        "subject": "=🎯 Job Matches Found ({{ $json.date }})",
        "html": "=<h2>New Job Match Found!</h2><p><strong>Role:</strong> {{ $json.role }}</p><p><strong>Company:</strong> {{ $json.company }}</p><p><strong>Match Score:</strong> {{ $json.score }}</p><p><strong>Location:</strong> {{ $json.location }}</p><p><strong>Tech Stack:</strong> {{ $json.techStack }}</p><p><a href=\"{{ $json.applyUrl }}\">👉 Click Here to Apply</a></p>",
        "options": {}
      },
      "id": "send-email",
      "name": "Send Email Alert",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2.1,
      "position": [
        1220,
        380
      ]
    },
    {
      "parameters": {
        "content": "### 1. Trigger\nRuns every weekday at 8:00 AM or manually on demand.",
        "height": 280,
        "width": 200,
        "color": 6
      },
      "id": "note-1",
      "name": "Sticky Note - Trigger",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        200,
        220
      ]
    },
    {
      "parameters": {
        "content": "### 2. Scrape & Match\nFetches remote jobs and scores them against candidate skills (0-100%).",
        "height": 280,
        "width": 420,
        "color": 4
      },
      "id": "note-2",
      "name": "Sticky Note - Scrape",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        460,
        220
      ]
    },
    {
      "parameters": {
        "content": "### 3. Save & Notify\nAppends matched jobs to Google Sheets and sends an email alert.",
        "height": 280,
        "width": 420,
        "color": 2
      },
      "id": "note-3",
      "name": "Sticky Note - Output",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        940,
        220
      ]
    }
  ],
